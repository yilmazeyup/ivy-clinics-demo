{
  "name": "pure-clinics",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/blanche",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace mobile run start",
    "ios": "npm --workspace mobile run ios",
    "web": "npm --workspace mobile run web",
    "typecheck": "npm --workspace mobile run typecheck",
    "admin": "npm --prefix apps/admin run dev",
    "blanche": "npm --workspace blanche run start",
    "blanche:web": "npm --workspace blanche run web",
    "typecheck:blanche": "npm --workspace blanche run typecheck",
    "admin:blanche": "npm --prefix apps/admin run dev:blanche"
  }
}
